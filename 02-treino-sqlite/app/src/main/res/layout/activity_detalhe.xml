<?xml version="1.0" encoding="utf-8"?>
<!-- Segunda tela do app. Nao tem nada de especial: e um layout como qualquer
     outro. O que a torna uma "tela" e ter uma Activity propria declarada no
     AndroidManifest.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detalhe_titulo"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detalheAtividade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/detalheTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/detalheData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/detalheAquecimento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/botaoVoltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/voltar" />

</LinearLayout>
