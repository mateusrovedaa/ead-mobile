<?xml version="1.0" encoding="utf-8"?>
<!-- Mesma tela da Unidade 2, com duas novidades:
     1. uma Toolbar no topo, que e onde o menu de opcoes aparece;
     2. a lista embaixo agora vem do banco, nao da memoria. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- O tema do app e NoActionBar, ou seja, a barra do topo NAO vem pronta.
         Quem quiser uma barra coloca a sua propria no layout, como esta aqui, e
         registra com setSupportActionBar() na Activity. E o caminho recomendado
         hoje: a barra passa a ser uma View comum, que voce posiciona e estiliza. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="?attr/colorOnPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imagemTreino"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/titulo"
                    android:src="@drawable/ic_treino" />

                <TextView
                    style="@style/TituloSecao"
                    android:labelFor="@+id/campoAtividade"
                    android:text="@string/rotulo_atividade" />

                <EditText
                    android:id="@+id/campoAtividade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/dica_atividade"
                    android:inputType="text|textCapSentences"
                    android:maxLines="1" />

                <TextView
                    style="@style/TituloSecao"
                    android:text="@string/rotulo_tipo" />

                <RadioGroup
                    android:id="@+id/grupoTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/tipoCardio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tipo_cardio" />

                    <RadioButton
                        android:id="@+id/tipoForca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/tipo_forca" />

                    <RadioButton
                        android:id="@+id/tipoAlongamento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/tipo_alongamento" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/caixaAquecimento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/fez_aquecimento" />

                <TextView
                    style="@style/TituloSecao"
                    android:text="@string/rotulo_data" />

                <DatePicker
                    android:id="@+id/seletorData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:calendarViewShown="false"
                    android:datePickerMode="spinner" />

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/botaoRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingVertical="12dp"
            android:text="@string/registrar" />

        <Button
            android:id="@+id/botaoLembrete"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/enviar_lembrete" />

        <TextView
            android:id="@+id/textoTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lista_vazia" />

        <ListView
            android:id="@+id/listaTreinos"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</LinearLayout>
